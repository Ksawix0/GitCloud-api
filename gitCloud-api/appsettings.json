{

  "Kestrel": {
    "Endpoints": {
      "GitCloudApiEndpoint": {
        "Url": "http://localhost:5250"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "GitCloudConfiguration": {
    "GitHubToken" : "",
    "RepositoryName" : "",
    "UserName" : "",
    "CacheQueueCapacity" : 50,
    "CacheModifyQueueCapacity" : 10
  },

  "JWTConfiguration": {
    "PrivateKeyBase64" : "",
    "PublicKeyBase64" : "",
    "Issuer": "GitCloudApi",
    "Audience" : "",
    "RefreshTokenExpirationTimeInDays": 30,
    "AccessTokenExpirationTimeInMinutes": 60
  }
}